{
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        { "source": "/restaurants.html", "destination": "/restaurants", "permanent": true }
    ],
    "headers": [
        {
            "source": "/images/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
            ]
        }
    ]
}
